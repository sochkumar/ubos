# Absolute URL of the backend. Axios uses this to build every /api/* request.
# For docker-compose, we build with REACT_APP_BACKEND_URL empty (=/) so
# API calls go same-origin and nginx proxies them to the backend container.
REACT_APP_BACKEND_URL=http://localhost:8001

# Enable the service worker in production builds ("1" to enable).
REACT_APP_ENABLE_SW=1

# When developing behind an HTTPS proxy that terminates TLS on 443, uncomment:
# WDS_SOCKET_PORT=443

# Health-check plugin (dev-only). Leave false unless you need it.
ENABLE_HEALTH_CHECK=false
