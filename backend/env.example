# ─── Database ───
MONGO_URL="mongodb://localhost:27017"
DB_NAME="ubos"

# ─── CORS ───
# Comma-separated origins, or "*" for open access.
CORS_ORIGINS="*"

# ─── Auth (JWT) ───
# ⚠ Generate a strong random secret for production (32+ bytes).
JWT_SECRET="CHANGE-ME-IN-PROD-please-use-a-32-byte-random-string"
JWT_ACCESS_TTL_MINUTES="15"
JWT_REFRESH_TTL_DAYS="30"

# ─── Optional: Google OAuth ───
# Leave as REPLACE_ME to disable Google sign-in.
GOOGLE_CLIENT_ID="REPLACE_ME"
GOOGLE_CLIENT_SECRET="REPLACE_ME"

# ─── URLs used in emails / QR payloads ───
APP_BASE_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# ─── Storage ───
STORAGE_BACKEND="local"
LOCAL_STORAGE_ROOT="/app/backend/uploads"
MEDIA_SIGNING_SECRET="CHANGE-ME-IN-PROD-32-byte-random"
MAX_UPLOAD_SIZE_BYTES="26214400"
DEFAULT_ORG_STORAGE_QUOTA_BYTES="5368709120"

# ─── Seed ───
# When "true" and the users collection is empty, the backend auto-seeds the
# three test users (owner/editor/viewer@ubos.test, password Passw0rd!)
# plus a demo org "Acme Furniture".
SEED_USERS="true"

# ─── Email ───
EMAIL_FROM="noreply@ubos.local"
EMAIL_FROM_NAME="UBOS"
# Set exactly ONE of these to enable a real provider.
# Otherwise the dev provider logs emails to stdout + dev_emails.log.
RESEND_API_KEY=""
SENDGRID_API_KEY=""
AWS_SES_REGION=""

# ─── Rate limits ───
INVITE_RATE_LIMIT_PER_HOUR="20"
PUBLIC_READ_RATE_LIMIT="120/minute"
PUBLIC_CODE_RATE_LIMIT="60/minute"

# ─── Reverse proxy ───
# When "true" (default), we trust the LEFTMOST X-Forwarded-For entry as the
# real client (correct behaviour behind Cloudflare / K8s ingress / ELB). Also
# consulted first: `CF-Connecting-IP`, which Cloudflare overwrites on every
# request. Set to "false" for the legacy right-index behaviour controlled by
# `TRUST_PROXY_HOPS` (only appropriate on deployments *without* a trusted
# front door).
TRUST_LEFTMOST_XFF="true"
TRUST_PROXY_HOPS="1"

# ─── Import / Export guardrails (optional) ───
# EXPORT_MAX_ROWS="100000"
# IMPORT_MAX_FILE_MB="10"
# IMPORT_MAX_ROWS="50000"
# IMPORT_TMP_ROOT="/tmp/ubos_imports"
