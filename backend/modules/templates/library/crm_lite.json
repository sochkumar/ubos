        {"key": "industry", "label": "Industry", "type": "text", "order": 3},
        {"key": "size", "label": "Size", "type": "dropdown", "config": {"options": ["1-10", "11-50", "51-200", "201-1000", "1000+"]}, "order": 4}
      ]
    }
