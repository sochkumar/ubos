  "icon": "Users",
  "cover_image": null,
  "entity_types": [
    {
      "key": "contacts",
      "name_singular": "Contact",
      "name_plural": "Contacts",
      "icon": "User",
      "color": "#7c3aed",
      "fields": [
        {"key": "full_name", "label": "Full name", "type": "text", "required": true, "order": 1},
        {"key": "email", "label": "Email", "type": "email", "order": 2},
        {"key": "phone", "label": "Phone", "type": "phone", "order": 3},
        {"key": "role", "label": "Role", "type": "text", "order": 4},
        {"key": "status", "label": "Status", "type": "dropdown", "config": {"options": ["Lead", "Active", "Churned"]}, "order": 5}
      ]
    },
    {
      "key": "companies",
      "name_singular": "Company",
      "name_plural": "Companies",
      "icon": "Building2",
      "color": "#0f766e",
